<Project>

  <!--
    外层多目标构建没有具体的 TargetPath；NuGet 的 buildMultiTargeting 是唯一会
    在这里导入的接缝。给出可读要求，内层由普通 targets 里的完整目标接管。
  -->
  <Target Name="PackPlugin">
    <Error Text="PackPlugin requires a single target framework; pass -f &lt;tfm&gt; to dotnet build -t:PackPlugin." />
  </Target>

</Project>
