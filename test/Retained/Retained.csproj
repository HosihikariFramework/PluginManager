<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Retained</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bindings.Stub/Bindings.Stub.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <ProjectReference Include="../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <!-- 模型是独立程序集（ADR-0059）：ExcludeAssets 不沿着项目引用链传递到它，得单列一条。 -->
    <ProjectReference Include="../../../Plugin.Abstractions/model/Hosihikari.Plugin.Model.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('../../../Plugin.Abstractions/src/Hosihikari.Plugin.Abstractions.csproj')">
    <PackageReference Include="Hosihikari.Plugin.Abstractions" Version="[3.0.0]" ExcludeAssets="runtime" />
    <PackageReference Include="Hosihikari.Plugin.Model" Version="[3.0.0]" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
